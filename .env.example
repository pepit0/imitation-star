# Copy to .env.local and fill in values.

# Required for Auto-separate (Demucs on Replicate)
REPLICATE_API_TOKEN=

# Optional: pin Demucs version (default: cjwbw/demucs abf8fe28…)
# REPLICATE_DEMUCS_VERSION=abf8fe28e407afa6d8e41e86a759caccc0af8e49c3c68016006b62cb0968441e

# Optional: OpenAI Whisper for auto clip suggestions (preferred over Replicate Whisper)
# OPENAI_API_KEY=

# Optional: pin Replicate Whisper version
# REPLICATE_WHISPER_VERSION=3ab86df6c8f54c11309d4d1f930ac292bad43ace52d10c80d87eb258b3c9f79c

# Supabase (Imitation Star) — Auth + profiles
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional legacy fallback if publishable key is unavailable
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
