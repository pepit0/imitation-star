# Origin only — the Expo shell always opens /play?client=app
# For local Next.js: EXPO_PUBLIC_APP_URL=http://YOUR_LAN_IP:3000
EXPO_PUBLIC_APP_URL=https://www.imitation.site

# RevenueCat public SDK key (safe in client builds).
# Test Store key while App Store / Play Console apps are being set up:
# EXPO_PUBLIC_REVENUECAT_API_KEY=test_xxxxxxxx
#
# Production (use platform-specific keys once store apps exist):
# EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_xxxxxxxx
# EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_xxxxxxxx
