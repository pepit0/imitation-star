{
  "expo": {
    "name": "Imitation Star",
    "slug": "imitation-star",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FF595E"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.imitationstar.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Imitation Star needs the microphone to record your dubs.",
        "NSCameraUsageDescription": "Imitation Star may use the camera for profile photos.",
        "NSPhotoLibraryUsageDescription": "Imitation Star may access photos for pack thumbnails.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FF595E"
      },
      "package": "com.imitationstar.app",
      "permissions": [
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "INTERNET"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "appUrl": "https://imitation-star.vercel.app"
    }
  }
}
